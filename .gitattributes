# Preserve exact source and evidence bytes across Windows/WSL checkouts.
# Editors should save new Python/shell files with LF.
*.py -text
*.sh -text
*.yaml -text
*.yml -text
*.md -text
# Publication manifests hash exact bytes, including intentional CSV CRLF.
*.csv -text
# csv.DictWriter intentionally emits CRLF. Audit whitespace without changing
# any exact-byte scientific checksum or disabling genuine trailing-space checks.
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.json -text
*.tex -text
*.bib -text
*.txt -text
*.pdf binary
*.png binary
*.zip binary
*.pt binary
*.npy binary
*.npz binary
*.jsonl -text
*.lock -text
*.zip.part[0-9][0-9][0-9] -text
