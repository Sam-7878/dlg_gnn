+        "roc_auc": 0.8, "pr_auc": 0.4, "oracle_best_f1": 0.5,
+        "validation_f1": 0.4, "f1_at_05": 0.3, "topk_f1": 0.4,
+        "positive_ratio": 0.1, "num_nodes": 10, "num_positive": 1,
+        "num_negative": 9, "status": "success",
+    })
+    path = tmp_path / "raw.csv"
