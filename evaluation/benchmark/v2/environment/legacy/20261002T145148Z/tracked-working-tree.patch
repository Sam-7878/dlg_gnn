+    p = Path(tmp) / "test.csv"
+    p.write_text(
+        "sample_id,timestamp,blocknumber,from,to\n"
+        "1,1000,100,0xA,0xB\n"
+        "2,,200,0xC,0xD\n",
+        encoding="utf-8",
