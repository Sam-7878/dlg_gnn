+def _hash_tensor(value: torch.Tensor) -> str:
+    array=value.detach().cpu().contiguous().numpy()
+    h=hashlib.sha256(); h.update(str(array.dtype).encode()); h.update(str(array.shape).encode()); h.update(array.tobytes())
+    return h.hexdigest()
+
