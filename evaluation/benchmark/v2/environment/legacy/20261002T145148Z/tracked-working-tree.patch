+def main() -> int:
+    ap=argparse.ArgumentParser(); ap.add_argument("--dataset-root",required=True); ap.add_argument("--results-root",required=True); ap.add_argument("--repo-root",default="."); ap.add_argument("--stats-only",action="store_true")
