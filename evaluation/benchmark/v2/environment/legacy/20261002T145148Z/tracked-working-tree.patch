+    gpu = _resolve_gpu(int(evaluation.get("gpu", 0 if torch.cuda.is_available() else -1)))
+    manifest["requested_gpu"] = int(evaluation.get("gpu", 0 if torch.cuda.is_available() else -1))
+    manifest["effective_gpu"] = gpu
