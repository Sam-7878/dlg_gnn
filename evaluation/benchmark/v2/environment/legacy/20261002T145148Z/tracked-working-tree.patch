+from gog_fraud.data.io.streaming_dataset import StatefulTransactionStream
+
+
+def events():
+    return [{"sample_id": f"s{i}", "chain_id": "eth", "contract_id": "c", "event_time": i, "block_number": i, "transaction_index": 0} for i in range(6)]
