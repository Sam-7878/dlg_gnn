+                        "error_type": type(exc).__name__, "error": str(exc), "oom": "out of memory" in str(exc).lower(),
+                        "fallback": False, "exclusion_justification": "real PyGOD execution failed; no substitute metric emitted"}
+                    failures.append(failed)
