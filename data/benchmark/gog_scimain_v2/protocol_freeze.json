{
  "benchmark_name": "GoG-SCIMain-v2",
  "benchmark_status": "CONDITIONAL_FALLBACK_IF_EXACT_V1_HASH_CONTRACT_FAILS",
  "frozen_before_test_inspection": true,
  "source": {
    "paper": "Multi-Chain Graphs of Graphs: A New Approach to Analyzing Blockchain Datasets",
    "paper_doi": "10.52202/079017-0894",
    "repository": "https://github.com/Xtra-Computing/Cryptocurrency-Graphs-of-graphs",
    "repository_commit": "7264f1bf510f7ba4f5041ac7a29b606abc12f262",
    "dataset_folder": "https://drive.google.com/drive/folders/1VV5ht9Eh8WGtKfkS0ipIk0FNI7g-WJfJ",
    "chains": ["ethereum", "bsc", "polygon"],
    "license": "CC BY-NC-SA 4.0"
  },
  "label_semantics": {
    "positive_label": 1,
    "mapping": "upstream Category 0 -> fraud/positive; every non-zero category -> benign/negative"
  },
  "timestamp": {
    "source_column": "timestamp",
    "semantics": "recorded on-chain token-transfer Unix timestamp",
    "timezone": "UTC"
  },
  "causal_graph_construction": {
    "window": "expanding contract-local transaction graph",
    "query_time": "maximum recorded transaction timestamp for the contract event",
    "edge_cutoff_rule": "edge_timestamp <= query_timestamp",
    "node_policy": "all endpoints observed at or before query timestamp",
    "max_edges_at_model_input": 128,
    "max_edge_selection": "most recent historical edges"
  },
  "split": {
    "pooling": "pool all three chains, then stable sort by query_time and event_id",
    "fractions": {"train": 0.70, "validation": 0.15, "test": 0.15},
    "class_support_gate": "positive_count > 0 and negative_count > 0 in every split",
    "boundary_policy": "fixed by fractions; never moved after performance inspection"
  },
  "features": ["log1p_in_degree", "log1p_out_degree", "log1p_total_degree"],
  "preprocessing": {
    "scaler_fit_scope": "train only",
    "model_selection_scope": "validation only",
    "test_access": "exactly once per frozen checkpoint"
  },
  "models": [
    "CausalLocalGIN deterministic",
    "CausalLocalGIN MC Dropout",
    "TGN-style event memory",
    "TGAT-style temporal attention",
    "fraud-oriented GraphSAGE",
    "validation-only temperature scaling",
    "five-model deep ensemble",
    "MC Dropout ensemble"
  ],
  "seeds": [7, 17, 27, 37, 47],
  "hyperparameter_policy": "reuse frozen Round 4/Round 6 model configurations; no test-directed search",
  "primary_metric": "AUC-PR",
  "secondary_metrics": ["ROC-AUC", "F1", "Brier", "ECE", "Adaptive ECE", "NLL"],
  "statistics": {
    "paired_bootstrap_resamples": 10000,
    "class_stratified_bootstrap_resamples": 10000,
    "paired_randomization_resamples": 10000
  },
  "branch_mixing_prohibited": true,
  "historical_v1_metrics_allowed_in_v2_tables": false
}
